# ============================================================================
# BuildFlow — client (Vite) environment
# Copy this file to `.env` (or `.env.local`) and fill in ONE analytics provider
# before launch. Vite only exposes vars prefixed with VITE_ to the browser bundle,
# and reads them at BUILD time — rebuild (or restart `npm run dev`) after changes.
#
# Analytics is OFF by default: with nothing set below, no third-party script loads,
# no cookies are set, and nothing is sent. The funnel is already fully instrumented
# in code (client/src/analytics.ts) — going live is just setting the vars below.
#
# Funnel events emitted: page_view (every welcome view), cta_click, waitlist_signup,
# demo_video_open, contact_sales_submit, enter_app. No PII (name/email) is ever sent.
# ============================================================================

# Which provider to use: plausible | ga | posthog | none
# Leave blank to auto-detect from whichever keys are set below.
# VITE_ANALYTICS_PROVIDER=plausible

# Log every event to the browser console even when a provider is live (for QA).
# In dev with NO provider set, console logging is already on automatically.
# VITE_ANALYTICS_DEBUG=true


# ── Option A — Plausible ────────────────────────────────────────────────────
# Privacy-first, lightweight, cookieless. No cookie-consent banner required.
# Uses the manual-pageview script by default (this is a hash SPA).
# VITE_ANALYTICS_PROVIDER=plausible
# VITE_PLAUSIBLE_DOMAIN=buildflow.com
# Self-hosting or proxying Plausible? Override the script URL:
# VITE_PLAUSIBLE_SRC=https://plausible.io/js/script.manual.js


# ── Option B — Google Analytics 4 ───────────────────────────────────────────
# Free and powerful, but sets cookies → you MUST present a cookie-consent banner
# (esp. EU/UK) and ideally wire Consent Mode. IP anonymization is enabled in code.
# VITE_ANALYTICS_PROVIDER=ga
# VITE_GA_ID=G-XXXXXXXXXX


# ── Option C — PostHog ──────────────────────────────────────────────────────
# Best for funnel analysis / product analytics. Configured cookieless in code
# (localStorage persistence, autocapture + session replay OFF).
# VITE_ANALYTICS_PROVIDER=posthog
# VITE_POSTHOG_KEY=phc_XXXXXXXXXXXXXXXXXXXXXXXX
# VITE_POSTHOG_HOST=https://us.i.posthog.com
