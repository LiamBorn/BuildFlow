{
  "name": "buildflow-scheduler",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "npm --workspace client run dev -- --host 0.0.0.0",
    "dev:server": "npm --workspace server run dev",
    "build": "npm --workspace shared run build && npm --workspace client run build",
    "start": "npm --workspace server run start",
    "test": "npm --workspaces --if-present test && npm --prefix admin-portal test && npm --prefix sales-desk test",
    "typecheck": "npm --workspace shared run build && npm --workspace shared exec -- tsc -p tsconfig.test.json && npm --workspace client exec -- tsc -b --pretty false && npm --workspace server run typecheck && npm --prefix admin-portal run typecheck && npm --prefix sales-desk run typecheck",
    "test:cpm": "npm --workspace shared run test:cpm",
    "test:tz": "node scripts/test-tz.mjs",
    "lint": "eslint \"client/src/**/*.{ts,tsx}\" \"shared/src/**/*.ts\" \"server/src/**/*.ts\" \"admin-portal/src/**/*.{ts,tsx}\" \"sales-desk/src/**/*.{ts,tsx}\"",
    "format": "prettier --write \"client/src/**/*.{ts,tsx,css}\" \"shared/src/**/*.ts\" \"server/src/**/*.ts\" \"server/test/**/*.ts\"",
    "seed:schedule": "npm --workspace server run seed:schedule",
    "format:check": "prettier --check \"client/src/**/*.{ts,tsx,css}\" \"shared/src/**/*.ts\" \"server/src/**/*.ts\" \"server/test/**/*.ts\"",
    "check:css": "node scripts/check-css.mjs",
    "test:perf": "npm --workspace shared run test:perf"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.3",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.69.0"
  }
}
