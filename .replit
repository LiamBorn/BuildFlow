# BuildFlow on Replit (docs/replit.md).
# One process serves everything on one port: the landing page, signing in and registering, the
# program, and the API behind them (server/src/serveClient.ts). `npm run build` writes the pages to
# client/dist; `npm start` runs the API server, which serves them in production.
# NODE_ENV=production is set only on the start commands: during the install it would leave out the
# dev dependencies the build and the server need (vite, tsx).
#
# ONE PORT, 5000, ON THE PUBLIC PORT 80, in the workspace and when published alike. A published
# Replit app may expose exactly one port, and it has to be the one on 80: an extra [[ports]] entry,
# or a server listening on a port that is not mapped to 80, fails the publish. (2026-09-24: Replit's
# Agent had moved Run to 5000, left the publish command on 4300 and exposed three ports.)
#
# Replit adds a [[ports]] entry by itself whenever something in the workspace listens on another
# port: the server's default 4300 came back as 4300 → 3000 after a verification run on 2026-09-24.
# Delete any such entry before publishing.
#
# The Run button goes through the workflow below, so the workflow does what `run` does: install,
# build, then start. Starting without the build serves whatever client/dist was left behind.

modules = ["nodejs-22", "postgresql-16", "python-base-3.13"]
run = "npm install && npm run build && NODE_ENV=production TRUST_PROXY=1 PORT=5000 npm start"

[deployment]
# A Reserved VM ("gce"; Autoscale is "cloudrun"): each workspace's database lives in the process and
# on its disk, and the live updates and scheduled jobs expect a single, always-on instance.
deploymentTarget = "gce"
build = ["sh", "-c", "npm ci && npm run build"]
run = ["sh", "-c", "NODE_ENV=production TRUST_PROXY=1 PORT=5000 npm start"]

[[ports]]
localPort = 5000
externalPort = 80

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm install && npm run build && NODE_ENV=production TRUST_PROXY=1 PORT=5000 npm start"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000
