modules = ["nodejs-22", "postgresql-16", "python-base-3.13"]
run = "npm install && npm run build && NODE_ENV=production TRUST_PROXY=1 PORT=5000 npm start"

[deployment]
# A Reserved VM ("gce"; Autoscale is "cloudrun"): each workspace's database lives in the process and
# on its disk, and the live updates and scheduled jobs expect a single, always-on instance.
deploymentTarget = "gce"
build = ["sh", "-c", "npm ci && npm run build"]
run = ["sh", "-c", "NODE_ENV=production TRUST_PROXY=1 PORT=5000 npm start"]

[[ports]]
localPort = 4300
externalPort = 3000

[[ports]]
localPort = 5000
externalPort = 80

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "NODE_ENV=production TRUST_PROXY=1 PORT=5000 npm start"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000
