<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The app's entitlements, applied by mac/scripts/embed-sparkle.sh when it signs BuildFlow.app.

  They only matter under the hardened runtime, which a Developer ID build has (DEVELOPER_ID set):
  there the microphone is refused, silently, to an app without audio-input, and voice (⌥ Space)
  would hear nothing. The ad hoc build has no hardened runtime, so there they change nothing.
  BuildFlow is not sandboxed, so there are no sandbox or network entitlements here.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
